# Copy to deploy/.env and replace every "changeme" value.
# deploy/.env is git-ignored; this template holds placeholders only.

# InfluxDB 2 first-run setup (applies only while the volume is empty)
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme-admin-password  # pragma: allowlist secret
INFLUXDB_ORG=home
INFLUXDB_BUCKET=trackiwi
# Operator (all-access) token. Used only by InfluxDB's own setup and by
# Grafana's provisioned datasource; the ingest container never sees it.
INFLUXDB_TOKEN=changeme-influx-token

# Ingest token, scoped to read + write on INFLUXDB_BUCKET only. Created after
# the first `up -d influxdb` (README "Option A", step 3):
#   influx auth create --org $INFLUXDB_ORG --description "trackiwi ingest" \
#     --write-bucket <bucket id> --read-bucket <bucket id>
INFLUXDB_INGEST_TOKEN=changeme-ingest-token

GRAFANA_ADMIN_PASSWORD=changeme-grafana-password  # pragma: allowlist secret

# Interfaces the published ports bind to. The default 127.0.0.1 keeps
# InfluxDB (8086) and Grafana (3000) reachable from this machine only.
# Uncomment with 0.0.0.0 (or one LAN interface address) to expose a service
# to the LAN deliberately; see README "Exposing the stack to the LAN".
# GRAFANA_BIND_ADDRESS=0.0.0.0
# INFLUXDB_BIND_ADDRESS=0.0.0.0

# Seconds between ingest runs
TRACKIWI_INGEST_INTERVAL=600
