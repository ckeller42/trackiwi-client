# --- Private data: NEVER commit anything below -------------------------------
# The position cache is a complete movement history of a physical vehicle.
# Treat everything here as if it were a password.
*.db
*.db-journal
*.sqlite
*.sqlite3
.trackiwi/
config.json
.env
.env.*
# InfluxDB side: the target config and the token/password files it may point
# at (examples/influx.example.toml documents them). The committed templates
# are named *.example.toml and example.env precisely so no pattern here
# matches them. `*.token`/`*.password` catch any name, `.token`/`.password`
# the bare dotfile form.
influx.toml
*.token
.token
*.password
.password

# Exported tracks (real coordinates). Synthetic test data lives in
# tests/fixtures/synthetic-* and is the ONLY location allowed to hold these.
#
# *.json and *.xml are here because `export --format geojson -o positions.json`
# is the natural filename (most GIS and JS tooling expects .json) and a GPX
# saved as track.xml is the same hole in the other format. A legitimate JSON or
# XML file therefore needs `git add -f`; the pre-commit guard then inspects its
# content and lets it through unless it really is a GeoJSON document.
*.gpx
*.geojson
*.kml
*.csv
*.json
*.xml
!tests/fixtures/synthetic-*
!deploy/grafana-dashboards/*.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Docs --------------------------------------------------------------------
# The Sphinx requirements-traceability build output. The build runs in CI as a
# gate; only its HTML hosting is deferred until the repo is public.
docs/_build/

# --- Editors / OS ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
